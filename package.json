{
  "name": "outboxer",
  "version": "0.1.0",
  "private": false,
  "description": "A transactional outbox for Postgres: publish an event in the same transaction as the write that caused it, then relay it with at-least-once delivery and per-aggregate ordering.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "schema.sql"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "demo": "tsx --env-file=.env examples/demo.ts"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
